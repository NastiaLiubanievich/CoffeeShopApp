<UserControl x:Class="CoffeeShopApp.OrdersHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock x:Name="TitleTextBlock" Text="Історія замовлень" FontSize="30" FontWeight="Bold" Foreground="#17120E"/>
                <TextBlock x:Name="SubtitleTextBlock" Text="Список усіх замовлень" Foreground="#6E6256" Margin="0,5,0,0"/>
            </StackPanel>

            <Button x:Name="CompletedFilterButton" Grid.Column="1" Content="Виконані" Height="42" Margin="0,4,10,0" Click="CompletedFilterButton_Click"/>
            <Button x:Name="CanceledFilterButton" Grid.Column="2" Content="Скасовані" Height="42" Margin="0,4,0,0" Style="{StaticResource GhostButtonStyle}" Click="CanceledFilterButton_Click"/>
        </Grid>

        <Border Grid.Row="1" Background="White" BorderBrush="#E7DED2" BorderThickness="1" CornerRadius="8" Effect="{StaticResource SoftShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="46"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Background="#FBF8F4" BorderBrush="#EFE7DE" BorderThickness="0,0,0,1" CornerRadius="8,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="OrderNumberHeaderTextBlock" Text="№ замовлення" FontSize="12" FontWeight="SemiBold" Foreground="#6E6256" VerticalAlignment="Center" Margin="16,0"/>
                        <TextBlock x:Name="DateHeaderTextBlock" Grid.Column="1" Text="Дата" FontSize="12" FontWeight="SemiBold" Foreground="#6E6256" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ItemsHeaderTextBlock" Grid.Column="2" Text="Позиції" FontSize="12" FontWeight="SemiBold" Foreground="#6E6256" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TotalHeaderTextBlock" Grid.Column="3" Text="Сума" FontSize="12" FontWeight="SemiBold" Foreground="#6E6256" VerticalAlignment="Center"/>
                        <TextBlock x:Name="PaymentHeaderTextBlock" Grid.Column="4" Text="Оплата" FontSize="12" FontWeight="SemiBold" Foreground="#6E6256" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatusHeaderTextBlock" Grid.Column="5" Text="Статус" FontSize="12" FontWeight="SemiBold" Foreground="#6E6256" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ActionsHeaderTextBlock" Grid.Column="6" Text="Дії" FontSize="12" FontWeight="SemiBold" Foreground="#6E6256" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="OrdersItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#EFE7DE" BorderThickness="0,0,0,1" Background="White">
                                    <Grid Height="56">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="170"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="150"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding OrderNumber}" FontWeight="SemiBold" Foreground="#17120E" VerticalAlignment="Center" Margin="16,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Date}" Foreground="#4C4034" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Products}" Foreground="#4C4034" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="3" Text="{Binding TotalText}" FontWeight="SemiBold" Foreground="#17120E" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="{Binding PaymentMethod}" Foreground="#4C4034" VerticalAlignment="Center"/>
                                        <Border Grid.Column="5" Background="{Binding StatusBackground}" CornerRadius="10" Padding="10,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusForeground}" FontWeight="SemiBold" FontSize="12"/>
                                        </Border>
                                        <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Button Content="{Binding ViewText}" Width="58" Height="28" Padding="0" FontSize="12" Style="{StaticResource GhostButtonStyle}" Tag="{Binding Id}" Click="ViewOrderButton_Click"/>
                                            <Button Content="{Binding CancelText}" Width="88" Height="28" Padding="0" FontSize="12" Margin="8,0,0,0" Tag="{Binding Id}" IsEnabled="{Binding CanCancel}" Click="CancelOrderButton_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
