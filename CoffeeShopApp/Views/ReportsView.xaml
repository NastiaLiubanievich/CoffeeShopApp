<UserControl x:Class="CoffeeShopApp.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock x:Name="TitleTextBlock" Text="Звіти" FontSize="30" FontWeight="Bold" Foreground="#17120E"/>
                <TextBlock x:Name="SubtitleTextBlock" Text="Аналітика та статистика" Foreground="#6E6256" Margin="0,5,0,0"/>
            </StackPanel>

            <ComboBox x:Name="PeriodComboBox"
                      Grid.Column="1"
                      Height="46"
                      SelectedIndex="0"
                      SelectionChanged="PeriodComboBox_SelectionChanged"
                      VerticalContentAlignment="Center">
                <ComboBoxItem x:Name="DayPeriodComboBoxItem" Content="За день"/>
                <ComboBoxItem x:Name="AllTimePeriodComboBoxItem" Content="За весь час"/>
            </ComboBox>

            <DatePicker x:Name="ReportDatePicker"
                        Grid.Column="3"
                        Height="46"
                        VerticalAlignment="Center"
                        SelectedDateFormat="Short"
                        SelectedDateChanged="ReportDatePicker_SelectedDateChanged"/>
        </Grid>

        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,22">
            <Border Background="White" BorderBrush="#E7DED2" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,12,0" Effect="{StaticResource SoftShadow}">
                <StackPanel>
                    <TextBlock x:Name="OrdersCountLabelTextBlock" Text="Кількість замовлень" Foreground="#6E6256"/>
                    <TextBlock x:Name="OrdersCountTextBlock" FontSize="30" FontWeight="Bold" Foreground="#17120E" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="White" BorderBrush="#E7DED2" BorderThickness="1" CornerRadius="8" Padding="18" Margin="4,0,8,0" Effect="{StaticResource SoftShadow}">
                <StackPanel>
                    <TextBlock x:Name="RevenueLabelTextBlock" Text="Загальна виручка" Foreground="#6E6256"/>
                    <TextBlock x:Name="RevenueTextBlock" FontSize="30" FontWeight="Bold" Foreground="#17120E" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="White" BorderBrush="#E7DED2" BorderThickness="1" CornerRadius="8" Padding="18" Margin="8,0,4,0" Effect="{StaticResource SoftShadow}">
                <StackPanel>
                    <TextBlock x:Name="AverageCheckLabelTextBlock" Text="Середній чек" Foreground="#6E6256"/>
                    <TextBlock x:Name="AverageCheckTextBlock" FontSize="30" FontWeight="Bold" Foreground="#17120E" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="White" BorderBrush="#E7DED2" BorderThickness="1" CornerRadius="8" Padding="18" Margin="12,0,0,0" Effect="{StaticResource SoftShadow}">
                <StackPanel>
                    <TextBlock x:Name="ProductsCountLabelTextBlock" Text="Товарів у меню" Foreground="#6E6256"/>
                    <TextBlock x:Name="ProductsCountTextBlock" FontSize="30" FontWeight="Bold" Foreground="#17120E" Margin="0,10,0,0"/>
                    <TextBlock x:Name="ActiveProductsLabelTextBlock" Text="активні позиції" Foreground="#3F8B45" FontWeight="SemiBold" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <Border Background="White" BorderBrush="#E7DED2" BorderThickness="1" CornerRadius="8" Padding="20" Effect="{StaticResource SoftShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="ChartTitleTextBlock"
                               Text="Виручка за день"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#17120E"
                               Margin="0,0,0,18"/>

                    <Canvas Grid.Row="1" x:Name="ChartCanvas" Height="300" VerticalAlignment="Top" SizeChanged="ChartCanvas_SizeChanged">
                        <Line X1="0" Y1="60" X2="620" Y2="60" Stroke="#EFE7DE"/>
                        <Line X1="0" Y1="120" X2="620" Y2="120" Stroke="#EFE7DE"/>
                        <Line X1="0" Y1="180" X2="620" Y2="180" Stroke="#EFE7DE"/>
                        <Line X1="0" Y1="240" X2="620" Y2="240" Stroke="#EFE7DE"/>
                        <Polyline x:Name="RevenuePolyline" Stroke="#A36B32" StrokeThickness="3" StrokeLineJoin="Round"/>
                    </Canvas>
                </Grid>
            </Border>

            <Border Grid.Column="1" Margin="18,0,0,0" Background="White" BorderBrush="#E7DED2" BorderThickness="1" CornerRadius="8" Padding="18" Effect="{StaticResource SoftShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="TopProductsTitleTextBlock" Text="Топ товарів" FontSize="18" FontWeight="Bold" Foreground="#17120E" Margin="0,0,0,14"/>
                    <ItemsControl x:Name="TopProductsItemsControl" Grid.Row="1">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="54" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="46"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="58"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" CornerRadius="6" ClipToBounds="True" Background="#F3EEE8">
                                        <Image Source="{Binding ImageSource}" Stretch="UniformToFill"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" Foreground="#17120E" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" Text="{Binding QuantityText}" Foreground="#4C4034" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="EmptyTopProductsTextBlock"
                               Grid.Row="1"
                               Text="За цей період продажів немає"
                               Foreground="#6E6256"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Visibility="Collapsed"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
