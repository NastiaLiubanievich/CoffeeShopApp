<UserControl x:Class="CoffeeShopApp.MenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock x:Name="TitleTextBlock" Text="Меню" FontSize="30" FontWeight="Bold" Foreground="#17120E"/>
                <TextBlock x:Name="SubtitleTextBlock" Text="Управління товарами" Foreground="#6E6256" Margin="0,4,0,0"/>
            </StackPanel>

            <Grid Grid.Column="1" Margin="0,4,0,0">
                <TextBox x:Name="SearchTextBox" Height="40" VerticalContentAlignment="Center" TextChanged="SearchTextBox_TextChanged"/>
                <TextBlock x:Name="SearchPlaceholderTextBlock"
                           Text="Пошук товарів..."
                           Foreground="#9A8F84"
                           Margin="16,0,0,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"/>
            </Grid>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="286"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="ProductsPanelBorder" Background="White" BorderBrush="#E7DED2" BorderThickness="1" CornerRadius="8" Padding="12" Effect="{StaticResource SoftShadow}">
                <DataGrid x:Name="ProductsDataGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          RowHeight="52"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          AlternatingRowBackground="#FBF8F4"
                          SelectionChanged="ProductsDataGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn x:Name="PhotoColumn" Header="Фото" Width="66">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Width="42" Height="34" CornerRadius="5" ClipToBounds="True">
                                        <Image Source="{Binding ImageSource}" Stretch="UniformToFill"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn x:Name="NameColumn" Header="Назва" Binding="{Binding Name}" Width="145"/>
                        <DataGridTextColumn x:Name="CategoryColumn" Header="Категорія" Binding="{Binding CategoryName}" Width="120"/>
                        <DataGridTextColumn x:Name="PriceColumn" Header="Ціна" Binding="{Binding PriceText}" Width="76"/>
                        <DataGridTemplateColumn x:Name="AvailableColumn" Header="Доступний" Width="94">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsAvailable}" IsEnabled="False" HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn x:Name="ActionsColumn" Header="Дії" Width="86">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button x:Name="EditRowButton" Content="Ред." Width="36" Height="26" Padding="0" FontSize="11" Tag="{Binding Id}" Style="{StaticResource GhostButtonStyle}" Click="EditButton_Click"/>
                                        <Button x:Name="DeleteRowButton" Content="Вид." Width="36" Height="26" Padding="0" FontSize="11" Margin="6,0,0,0" Tag="{Binding Id}" Style="{StaticResource GhostButtonStyle}" Click="DeleteButton_Click"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border x:Name="ProductFormBorder" Grid.Column="1" Margin="18,0,0,0" Background="White" BorderBrush="#E7DED2" BorderThickness="1" CornerRadius="8" Padding="18" Effect="{StaticResource SoftShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="FormTitleTextBlock" Text="Додати товар" FontWeight="Bold" FontSize="16" Foreground="#17120E" Margin="0,0,0,16"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock x:Name="NameLabelTextBlock" Text="Назва товару" Foreground="#6E6256"/>
                            <TextBox x:Name="NameTextBox" Margin="0,6,0,12"/>
                            <TextBlock x:Name="CategoryLabelTextBlock" Text="Категорія" Foreground="#6E6256"/>
                            <ComboBox x:Name="CategoryComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Height="38" Margin="0,6,0,12"/>
                            <TextBlock x:Name="PriceLabelTextBlock" Text="Ціна (грн)" Foreground="#6E6256"/>
                            <TextBox x:Name="PriceTextBox" Margin="0,6,0,12"/>
                            <TextBlock x:Name="DescriptionLabelTextBlock" Text="Опис" Foreground="#6E6256"/>
                            <TextBox x:Name="DescriptionTextBox" Height="66" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,6,0,12"/>
                            <TextBlock x:Name="ImagePathLabelTextBlock" Text="Шлях до фото" Foreground="#6E6256"/>
                            <TextBox x:Name="ImagePathTextBox" Margin="0,6,0,12"/>
                            <CheckBox x:Name="AvailableCheckBox" Content="Доступний" IsChecked="True"/>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Row="2" Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="CancelButton" Content="Скасувати" Height="42" Style="{StaticResource GhostButtonStyle}" Margin="0,0,8,0" Click="CancelButton_Click"/>
                        <Button x:Name="SaveButton" Grid.Column="1" Content="Зберегти" Height="42" Margin="8,0,0,0" Click="SaveButton_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
