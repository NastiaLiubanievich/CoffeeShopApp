<Window x:Class="CoffeeShopApp.OrdersHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CoffeeShopApp"
        Title="Історія замовлень"
        Height="680"
        Width="1120"
        WindowStartupLocation="CenterOwner"
        Background="#F8F6F2">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <local:NavigationPanel ActivePage="OrdersHistory"/>

        <Grid Grid.Column="1" Margin="26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="Історія замовлень"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#17120E"/>
                <TextBlock Text="Збережені продажі з бази даних"
                           Foreground="#6E6256"
                           Margin="0,5,0,0"/>
            </StackPanel>

            <Border Grid.Row="1"
                    Background="White"
                    BorderBrush="#E7DED2"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    Effect="{StaticResource SoftShadow}">
                <DataGrid x:Name="OrdersDataGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="№" Binding="{Binding Id}" Width="80"/>
                        <DataGridTextColumn Header="Дата" Binding="{Binding Date}" Width="180"/>
                        <DataGridTextColumn Header="Позицій" Binding="{Binding ItemsCount}" Width="110"/>
                        <DataGridTextColumn Header="Товари" Binding="{Binding Products}" Width="*"/>
                        <DataGridTextColumn Header="Сума" Binding="{Binding Total, StringFormat={}{0:0} грн}" Width="130"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,18,0,0">
                <Button Content="Оновити" Width="120" Click="RefreshButton_Click"/>
                <Button Content="Закрити" Width="120" Margin="12,0,0,0" Style="{StaticResource GhostButtonStyle}" Click="CloseButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
