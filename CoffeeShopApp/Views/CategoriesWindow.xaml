<Window x:Class="CoffeeShopApp.CategoriesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CoffeeShopApp"
        Title="Категорії"
        Height="720"
        Width="1120"
        WindowStartupLocation="CenterOwner"
        Background="#F8F6F2">

    <Window.Resources>
        <DataTemplate x:Key="CategoryCardTemplate">
            <Border Width="210"
                    Height="260"
                    Background="White"
                    BorderBrush="#E7DED2"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="0,0,18,18"
                    Padding="18"
                    Effect="{StaticResource SoftShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="112"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Image Source="{Binding ImageSource}"
                           Width="104"
                           Height="96"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="1"
                               Text="{Binding Name}"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="#17120E"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0"/>

                    <TextBlock Grid.Row="2"
                               Text="{Binding ProductsCountText}"
                               FontSize="12"
                               Foreground="#6E6256"
                               HorizontalAlignment="Center"
                               Margin="0,6,0,0"/>

                    <StackPanel Grid.Row="4"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <Button Content="Ред."
                                Width="48"
                                Height="34"
                                Padding="0"
                                FontSize="12"
                                Style="{StaticResource GhostButtonStyle}"
                                Tag="{Binding Id}"
                                Click="EditCategoryButton_Click"/>
                        <Button Content="Вид."
                                Width="48"
                                Height="34"
                                Padding="0"
                                FontSize="12"
                                Margin="14,0,0,0"
                                Style="{StaticResource GhostButtonStyle}"
                                Tag="{Binding Id}"
                                Click="DeleteCategoryButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <local:NavigationPanel ActivePage="Categories"/>

        <Grid Grid.Column="1" Margin="26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="170"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Категорії"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#17120E"/>
                    <TextBlock Text="Управління категоріями товарів"
                               Foreground="#6E6256"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="+ Додати категорію"
                        Height="42"
                        Margin="0,4,0,0"
                        Click="AddCategoryButton_Click"/>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="CategoriesItemsControl"
                              ItemTemplate="{StaticResource CategoryCardTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
