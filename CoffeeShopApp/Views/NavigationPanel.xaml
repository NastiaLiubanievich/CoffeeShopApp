<UserControl x:Class="CoffeeShopApp.NavigationPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="220">
    <Border Background="#332719">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="210"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="8">
                <Image Source="pack://application:,,,/Assets/Brand/Logo.png"
                       Width="173"
                       Height="132"
                       Stretch="Uniform"/>
                <TextBlock Text="COFFEE"
                           FontSize="24"
                           Foreground="#E0AE65"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="SHOP"
                           FontSize="24"
                           Foreground="#E0AE65"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="10,24,10,12">
                <Button x:Name="OrdersButton" Style="{StaticResource NavButtonStyle}" Content="Замовлення" Click="OrdersButton_Click"/>
                <Button x:Name="MenuButton" Style="{StaticResource NavButtonStyle}" Content="Меню" Click="MenuButton_Click"/>
                <Button x:Name="CategoriesButton" Style="{StaticResource NavButtonStyle}" Content="Категорії" Click="CategoriesButton_Click"/>
                <Button x:Name="OrdersHistoryButton" Style="{StaticResource NavButtonStyle}" Content="Історія замовлень" Click="OrdersHistoryButton_Click"/>
                <Button x:Name="ReportsButton" Style="{StaticResource NavButtonStyle}" Content="Звіти" Click="ReportsButton_Click"/>
                <Button x:Name="SettingsButton" Style="{StaticResource NavButtonStyle}" Content="Налаштування" Click="SettingsButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
