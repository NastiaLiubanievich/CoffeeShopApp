<Window x:Class="CoffeeShopApp.MenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Меню"
        Height="760"
        Width="1220"
        MinHeight="680"
        MinWidth="1040"
        WindowStartupLocation="CenterOwner"
        Background="#F8F6F2">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="54"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.RowSpan="2" Background="#332719">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="86"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="122"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="18,0">
                    <Image Source="pack://application:,,,/Assets/Brand/Logo.png"
                           Width="28"
                           Height="28"
                           Stretch="Uniform"/>
                    <TextBlock Text="CoffeeShop"
                               Foreground="#E0AE65"
                               FontWeight="Bold"
                               FontSize="16"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="12,14">
                    <Button Style="{StaticResource NavButtonStyle}" Content="Замовлення"/>
                    <Button Style="{StaticResource NavButtonStyle}" Content="Меню" Background="#B99B77"/>
                    <Button Style="{StaticResource NavButtonStyle}" Content="Категорії"/>
                    <Button Style="{StaticResource NavButtonStyle}" Content="Історія замовлень"/>
                    <Button Style="{StaticResource NavButtonStyle}" Content="Звіти"/>
                    <Button Style="{StaticResource NavButtonStyle}" Content="Налаштування"/>
                </StackPanel>

                <Border Grid.Row="2"
                        Margin="14,0,14,18"
                        BorderBrush="#5B4A36"
                        BorderThickness="1"
                        CornerRadius="8"
                        Background="#3C2D1E">
                    <Grid Margin="16,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="1"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="Сьогодні" Foreground="#D8C7B3" FontSize="12"/>
                            <TextBlock Text="17 травня 2026" Foreground="White" Margin="0,5,0,0"/>
                        </StackPanel>
                        <Rectangle Grid.Row="1" Fill="#5B4A36" Margin="0,6"/>
                        <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
                            <TextBlock Text="Час" Foreground="#D8C7B3" FontSize="12"/>
                            <TextBlock Text="14:04" Foreground="White" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Column="1"
                Background="#FCFAF7"
                BorderBrush="#E3DCD3"
                BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="☰"
                           FontSize="18"
                           Foreground="#3B2C1D"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2"
                           Text="Адміністратор"
                           Foreground="#4C4034"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Grid.Column="1" Margin="26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="144"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Меню"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#17120E"/>
                    <TextBlock Text="Управління товарами"
                               Foreground="#6E6256"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <TextBox x:Name="SearchTextBox"
                         Grid.Column="1"
                         Height="40"
                         Margin="0,4,12,0"
                         VerticalContentAlignment="Center"
                         TextChanged="SearchTextBox_TextChanged"/>

                <Button Grid.Column="2"
                        Content="+ Додати товар"
                        Height="40"
                        Margin="0,4,0,0"
                        Click="AddNewButton_Click"/>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="286"/>
                </Grid.ColumnDefinitions>

                <Border Background="White"
                        BorderBrush="#E7DED2"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12"
                        Effect="{StaticResource SoftShadow}">
                    <DataGrid x:Name="ProductsDataGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              RowHeight="52"
                              AlternatingRowBackground="#FBF8F4"
                              SelectionChanged="ProductsDataGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Фото" Width="66">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Width="42" Height="34" CornerRadius="5" ClipToBounds="True">
                                            <Image Source="{Binding ImageSource}" Stretch="UniformToFill"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Назва" Binding="{Binding Name}" Width="145"/>
                            <DataGridTextColumn Header="Категорія" Binding="{Binding CategoryName}" Width="120"/>
                            <DataGridTextColumn Header="Ціна" Binding="{Binding Price, StringFormat={}{0:0} грн}" Width="76"/>
                            <DataGridTemplateColumn Header="Доступний" Width="94">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsAvailable}"
                                                  IsEnabled="False"
                                                  HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Дії" Width="86">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="Ред."
                                                    Width="36"
                                                    Height="26"
                                                    Padding="0"
                                                    FontSize="11"
                                                    Tag="{Binding Id}"
                                                    Style="{StaticResource GhostButtonStyle}"
                                                    Click="EditButton_Click"/>
                                            <Button Content="Вид."
                                                    Width="36"
                                                    Height="26"
                                                    Padding="0"
                                                    FontSize="11"
                                                    Margin="6,0,0,0"
                                                    Tag="{Binding Id}"
                                                    Style="{StaticResource GhostButtonStyle}"
                                                    Click="DeleteButton_Click"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <Border Grid.Column="1"
                        Margin="18,0,0,0"
                        Background="White"
                        BorderBrush="#E7DED2"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="18"
                        Effect="{StaticResource SoftShadow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="FormTitleTextBlock"
                                   Text="Додати товар"
                                   FontWeight="Bold"
                                   FontSize="16"
                                   Foreground="#17120E"
                                   Margin="0,0,0,16"/>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Height="96"
                                        BorderBrush="#E7DED2"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Background="#F8F6F2"
                                        Margin="0,0,0,14">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="Фото товару"
                                                   FontWeight="SemiBold"
                                                   Foreground="#6E6256"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="вкажіть шлях нижче"
                                                   FontSize="11"
                                                   Foreground="#9A8F84"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Назва товару" Foreground="#6E6256"/>
                                <TextBox x:Name="NameTextBox" Margin="0,6,0,12"/>

                                <TextBlock Text="Категорія" Foreground="#6E6256"/>
                                <ComboBox x:Name="CategoryComboBox"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Id"
                                          Height="38"
                                          Margin="0,6,0,12"/>

                                <TextBlock Text="Ціна (грн)" Foreground="#6E6256"/>
                                <TextBox x:Name="PriceTextBox" Margin="0,6,0,12"/>

                                <TextBlock Text="Опис" Foreground="#6E6256"/>
                                <TextBox x:Name="DescriptionTextBox"
                                         Height="66"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         Margin="0,6,0,12"/>

                                <TextBlock Text="Шлях до фото" Foreground="#6E6256"/>
                                <TextBox x:Name="ImagePathTextBox" Margin="0,6,0,12"/>

                                <CheckBox x:Name="AvailableCheckBox"
                                          Content="Доступний"
                                          IsChecked="True"/>
                            </StackPanel>
                        </ScrollViewer>

                        <Grid Grid.Row="2" Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Content="Скасувати"
                                    Height="42"
                                    Style="{StaticResource GhostButtonStyle}"
                                    Margin="0,0,8,0"
                                    Click="CancelButton_Click"/>
                            <Button Grid.Column="1"
                                    Content="Зберегти"
                                    Height="42"
                                    Margin="8,0,0,0"
                                    Click="SaveButton_Click"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
