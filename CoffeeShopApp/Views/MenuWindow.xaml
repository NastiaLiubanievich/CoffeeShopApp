<Window x:Class="CoffeeShopApp.MenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Меню"
        Height="720"
        Width="1120"
        MinHeight="640"
        MinWidth="980"
        WindowStartupLocation="CenterOwner"
        Background="#F8F6F2">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="140"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Меню"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#17120E"/>
                <TextBlock Text="Управління товарами"
                           Foreground="#6E6256"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <TextBox x:Name="SearchTextBox"
                     Grid.Column="1"
                     Height="40"
                     Margin="0,4,12,0"
                     VerticalContentAlignment="Center"
                     TextChanged="SearchTextBox_TextChanged"/>

            <Button Grid.Column="2"
                    Content="+ Додати товар"
                    Height="40"
                    Margin="0,4,0,0"
                    Click="AddNewButton_Click"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="286"/>
            </Grid.ColumnDefinitions>

            <Border Background="White"
                    BorderBrush="#E7DED2"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    Effect="{StaticResource SoftShadow}">
                <DataGrid x:Name="ProductsDataGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          RowHeight="58"
                          SelectionChanged="ProductsDataGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Фото" Width="72">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Width="44" Height="36" CornerRadius="5" ClipToBounds="True">
                                        <Image Source="{Binding ImageSource}" Stretch="UniformToFill"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Назва" Binding="{Binding Name}" Width="150"/>
                        <DataGridTextColumn Header="Категорія" Binding="{Binding CategoryName}" Width="128"/>
                        <DataGridTextColumn Header="Ціна" Binding="{Binding Price, StringFormat={}{0:0} грн}" Width="78"/>
                        <DataGridTemplateColumn Header="Доступний" Width="96">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsAvailable}"
                                              IsEnabled="False"
                                              HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Дії" Width="94">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="✎"
                                                Width="30"
                                                Height="28"
                                                Padding="0"
                                                Tag="{Binding Id}"
                                                Style="{StaticResource GhostButtonStyle}"
                                                Click="EditButton_Click"/>
                                        <Button Content="🗑"
                                                Width="30"
                                                Height="28"
                                                Padding="0"
                                                Margin="6,0,0,0"
                                                Tag="{Binding Id}"
                                                Style="{StaticResource GhostButtonStyle}"
                                                Click="DeleteButton_Click"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="1"
                    Margin="18,0,0,0"
                    Background="White"
                    BorderBrush="#E7DED2"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="18"
                    Effect="{StaticResource SoftShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="FormTitleTextBlock"
                               Text="Додати товар"
                               FontWeight="Bold"
                               FontSize="16"
                               Foreground="#17120E"
                               Margin="0,0,0,16"/>

                    <StackPanel Grid.Row="1">
                        <Border Height="96"
                                BorderBrush="#E7DED2"
                                BorderThickness="1"
                                CornerRadius="8"
                                Background="#F8F6F2"
                                Margin="0,0,0,14">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="Фото товару"
                                           FontWeight="SemiBold"
                                           Foreground="#6E6256"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="вкажіть шлях нижче"
                                           FontSize="11"
                                           Foreground="#9A8F84"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Назва товару" Foreground="#6E6256"/>
                        <TextBox x:Name="NameTextBox" Margin="0,6,0,12"/>

                        <TextBlock Text="Категорія" Foreground="#6E6256"/>
                        <ComboBox x:Name="CategoryComboBox"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  Height="38"
                                  Margin="0,6,0,12"/>

                        <TextBlock Text="Ціна (грн)" Foreground="#6E6256"/>
                        <TextBox x:Name="PriceTextBox" Margin="0,6,0,12"/>

                        <TextBlock Text="Опис" Foreground="#6E6256"/>
                        <TextBox x:Name="DescriptionTextBox"
                                 Height="66"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 Margin="0,6,0,12"/>

                        <TextBlock Text="Шлях до фото" Foreground="#6E6256"/>
                        <TextBox x:Name="ImagePathTextBox" Margin="0,6,0,12"/>

                        <CheckBox x:Name="AvailableCheckBox"
                                  Content="Доступний"
                                  IsChecked="True"/>
                    </StackPanel>

                    <Grid Grid.Row="2" Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="Скасувати"
                                Height="42"
                                Style="{StaticResource GhostButtonStyle}"
                                Margin="0,0,8,0"
                                Click="CancelButton_Click"/>
                        <Button Grid.Column="1"
                                Content="Зберегти"
                                Height="42"
                                Margin="8,0,0,0"
                                Click="SaveButton_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
