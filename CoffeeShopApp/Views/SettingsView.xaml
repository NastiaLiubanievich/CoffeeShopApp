<UserControl x:Class="CoffeeShopApp.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E7DED2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="22"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Effect" Value="{StaticResource SoftShadow}"/>
        </Style>

        <Style x:Key="IconCircleStyle" TargetType="Border">
            <Setter Property="Width" Value="72"/>
            <Setter Property="Height" Value="72"/>
            <Setter Property="CornerRadius" Value="36"/>
            <Setter Property="Background" Value="#F6EFE7"/>
        </Style>

        <Style x:Key="SettingsOptionButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
            <Setter Property="Width" Value="150"/>
            <Setter Property="Height" Value="58"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E7DED2"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#17120E"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,26">
            <TextBlock x:Name="TitleTextBlock"
                       Text="Налаштування"
                       FontSize="34"
                       FontWeight="Bold"
                       Foreground="#17120E"/>
            <TextBlock x:Name="SubtitleTextBlock"
                       Text="Керуйте зовнішнім виглядом та акаунтом"
                       FontSize="16"
                       Foreground="#5F5850"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource IconCircleStyle}">
                        <TextBlock Text="АК"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#7B4A1F"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Ваш акаунт"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#17120E"/>
                        <TextBlock Text="Користувач"
                                   FontSize="14"
                                   Foreground="#6E6256"
                                   Margin="0,16,0,0"/>
                        <TextBlock x:Name="CurrentUserTextBlock"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#17120E"
                                   Margin="0,4,0,0"/>

                        <Border Background="#EEF7E9"
                                CornerRadius="8"
                                Padding="10,6"
                                HorizontalAlignment="Left"
                                Margin="0,18,0,0">
                            <TextBlock Text="Повний доступ до системи"
                                       Foreground="#395C2D"
                                       FontSize="15"
                                       FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>

                    <Rectangle Grid.Column="2" Fill="#E7DED2" Margin="0,34"/>

                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="40,0,0,0">
                        <TextBlock Text="Роль"
                                   FontSize="15"
                                   Foreground="#6E6256"/>
                        <TextBlock x:Name="CurrentRoleTextBlock"
                                   FontSize="19"
                                   FontWeight="Bold"
                                   Foreground="#17120E"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource IconCircleStyle}">
                        <TextBlock Text="◐"
                                   FontSize="34"
                                   Foreground="#7B4A1F"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Тема інтерфейсу"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#17120E"/>
                        <TextBlock Text="Оберіть режим відображення"
                                   FontSize="15"
                                   Foreground="#6E6256"
                                   Margin="0,8,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="LightThemeButton"
                                Style="{StaticResource SettingsOptionButtonStyle}"
                                Content="Світла"
                                Click="LightThemeButton_Click"/>
                        <Button x:Name="DarkThemeButton"
                                Style="{StaticResource SettingsOptionButtonStyle}"
                                Content="Темна"
                                Margin="16,0,0,0"
                                Click="DarkThemeButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource IconCircleStyle}" Background="#FFF0ED">
                        <TextBlock Text="↪"
                                   FontSize="34"
                                   Foreground="#C7372F"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Вихід з облікового запису"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#17120E"/>
                        <TextBlock Text="Повернутися на екран входу в систему"
                                   FontSize="15"
                                   Foreground="#6E6256"
                                   Margin="0,8,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="2"
                            Content="Вийти з акаунта"
                            Width="190"
                            Height="58"
                            Background="White"
                            Foreground="#C7372F"
                            BorderBrush="#E3544D"
                            BorderThickness="1"
                            Click="LogoutButton_Click"/>
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
