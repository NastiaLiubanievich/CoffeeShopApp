<Window x:Class="CoffeeShopApp.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вхід"
        Width="920"
        Height="620"
        MinWidth="820"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F8F6F2">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="#332719">
            <Grid Margin="34">
                <StackPanel VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/Brand/Logo.png"
                           Width="132"
                           Height="132"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"/>
                    <TextBlock Text="COFFEE"
                               FontSize="30"
                               FontWeight="SemiBold"
                               Foreground="#E0AE65"
                               HorizontalAlignment="Center"
                               Margin="0,22,0,0"/>
                    <TextBlock Text="SHOP"
                               FontSize="30"
                               FontWeight="SemiBold"
                               Foreground="#E0AE65"
                               HorizontalAlignment="Center"
                               Margin="0,2,0,0"/>
                    <Rectangle Height="1"
                               Fill="#8B6740"
                               Margin="54,24"/>
                    <TextBlock Text="Система управління кав'ярнею"
                               Foreground="#D8C7B3"
                               TextAlignment="Center"
                               FontSize="15"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="62,42">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="Вхід у систему"
                           FontSize="34"
                           FontWeight="Bold"
                           Foreground="#17120E"/>
                <TextBlock Text="Увійдіть під своїм обліковим записом"
                           FontSize="15"
                           Foreground="#6E6256"
                           Margin="0,8,0,0"/>
            </StackPanel>

            <Border Grid.Row="1"
                    Background="White"
                    BorderBrush="#E7DED2"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="30"
                    Margin="0,26,0,0"
                    Effect="{StaticResource SoftShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Логін"
                               FontWeight="SemiBold"
                               Foreground="#3B2C1D"/>
                    <TextBox x:Name="UsernameTextBox"
                             Grid.Row="1"
                             Height="46"
                             Margin="0,8,0,18"
                             VerticalContentAlignment="Center"/>

                    <TextBlock Grid.Row="2"
                               Text="Пароль"
                               FontWeight="SemiBold"
                               Foreground="#3B2C1D"/>
                    <PasswordBox x:Name="PasswordBox"
                                 Grid.Row="3"
                                 Height="46"
                                 Padding="14,10"
                                 Margin="0,8,0,18"
                                 BorderBrush="#E8E1D8"
                                 BorderThickness="1"
                                 Background="White"
                                 PasswordChar="*"
                                 VerticalContentAlignment="Center"
                                 KeyDown="PasswordBox_KeyDown"/>

                    <StackPanel Grid.Row="4">
                        <TextBlock x:Name="ErrorTextBlock"
                                   Foreground="#B23A2F"
                                   FontWeight="SemiBold"
                                   Visibility="Collapsed"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10"/>

                        <Button Content="Увійти"
                                Height="52"
                                Click="LoginButton_Click"/>

                        <Border Background="#F8F6F2"
                                CornerRadius="8"
                                Padding="14"
                                Margin="0,18,0,0">
                            <TextBlock Foreground="#6E6256"
                                       TextWrapping="Wrap"
                                       LineHeight="22"
                                       Text="Тестові акаунти: admin / admin123, cashier / cashier123, manager / manager123"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
