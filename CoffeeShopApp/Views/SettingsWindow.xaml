<Window x:Class="CoffeeShopApp.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Налаштування"
        Height="540"
        Width="780"
        WindowStartupLocation="CenterOwner"
        Background="#F8F6F2">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="58"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Width="48"
                    Height="48"
                    Background="#3B2C1D"
                    CornerRadius="10"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top">
                <TextBlock Text="⚙"
                           FontSize="26"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1">
                <TextBlock Text="Налаштування"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#17120E"/>
                <TextBlock Text="Параметри роботи системи"
                           Foreground="#6E6256"
                           Margin="0,5,0,0"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#E7DED2"
                BorderThickness="1"
                CornerRadius="8"
                Padding="28"
                Effect="{StaticResource SoftShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="1"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="CoffeeShop System"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#17120E"/>
                    <TextBlock Text="Версія: 1.0.0"
                               Foreground="#6E6256"
                               Margin="0,12,0,0"/>
                    <TextBlock Text="Користувач: Адміністратор"
                               Foreground="#6E6256"
                               Margin="0,8,0,0"/>
                    <TextBlock Text="База даних: CoffeeShopDb"
                               Foreground="#6E6256"
                               Margin="0,8,0,0"/>
                </StackPanel>

                <Rectangle Grid.Row="1" Fill="#D8CEC2" Margin="0,26"/>

                <StackPanel Grid.Row="2">
                    <CheckBox x:Name="ConfirmCheckBox"
                              Content="Показувати повідомлення після збереження замовлення"
                              IsChecked="True"
                              Checked="ConfirmCheckBox_Changed"
                              Unchecked="ConfirmCheckBox_Changed"
                              FontSize="16"
                              Foreground="#3B2C1D"
                              Margin="0,0,0,18"/>
                    <CheckBox x:Name="LightThemeCheckBox"
                              Content="Використовувати світлу тему для цього вікна"
                              IsChecked="True"
                              Checked="LightThemeCheckBox_Changed"
                              Unchecked="LightThemeCheckBox_Changed"
                              FontSize="16"
                              Foreground="#3B2C1D"/>
                </StackPanel>
            </Grid>
        </Border>

        <Button Grid.Row="2"
                Content="Закрити"
                Width="120"
                HorizontalAlignment="Right"
                Margin="0,18,0,0"
                Style="{StaticResource GhostButtonStyle}"
                Click="CloseButton_Click"/>
    </Grid>
</Window>
