<Window x:Class="CoffeeShopApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CoffeeShop"
        Height="850"
        Width="1450"
        MinHeight="720"
        MinWidth="1150"
        WindowStartupLocation="CenterScreen"
        Background="#F8F6F2">

    <Window.Resources>
        <Style x:Key="CategoryButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
            <Setter Property="Height" Value="50"/>
            <Setter Property="Width" Value="110"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#E7DED2"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <DataTemplate x:Key="ProductCardTemplate">
            <Button Click="AddProductButton_Click"
                    Tag="{Binding Product}"
                    Background="Transparent"
                    Padding="0"
                    Margin="0,0,14,18"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top">
                <Border Width="190"
                        Height="270"
                        Background="White"
                        BorderBrush="{Binding AccentBrush}"
                        BorderThickness="{Binding AccentThickness}"
                        CornerRadius="8"
                        Effect="{StaticResource SoftShadow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="143"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border CornerRadius="8,8,0,0"
                                Width="190"
                                Height="143">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding ImageSource}"
                                            Stretch="Uniform"
                                            AlignmentX="Center"
                                            AlignmentY="Center"
                                            TileMode="None"/>
                            </Border.Background>
                        </Border>

                        <Grid Grid.Row="1" Margin="16,12,14,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="{Binding Product.Name}"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="#17120E"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Row="1"
                                       Text="{Binding Product.Description}"
                                       FontSize="12"
                                       Foreground="#5F5850"
                                       TextWrapping="Wrap"
                                       MaxHeight="38"
                                       Margin="0,8,0,0"/>
                            <DockPanel Grid.Row="3" LastChildFill="False">
                                <TextBlock Text="{Binding Product.Price, StringFormat={}{0:0} грн}"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           Foreground="#17120E"
                                           VerticalAlignment="Center"/>
                                <Border DockPanel.Dock="Right"
                                        Width="34"
                                        Height="34"
                                        Background="#3B2C1D"
                                        CornerRadius="8">
                                    <TextBlock Text="+"
                                               Foreground="White"
                                               FontSize="22"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Margin="0,-3,0,0"/>
                                </Border>
                            </DockPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="CartItemTemplate">
            <Grid Margin="0,10" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="76"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="{Binding Product.Name}"
                               FontWeight="SemiBold"
                               Foreground="#17120E"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Product.Price, StringFormat={}{0:0} грн}"
                               Foreground="#6E6256"
                               FontSize="12"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Height="34"
                        BorderBrush="#E7DED2"
                        BorderThickness="1"
                        CornerRadius="7"
                        VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="-"
                                Tag="{Binding Product.Id}"
                                Click="DecreaseCartButton_Click"
                                Padding="0"
                                Background="Transparent"
                                Foreground="#3B2C1D"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Quantity}"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="2"
                                Content="+"
                                Tag="{Binding Product.Id}"
                                Click="IncreaseCartButton_Click"
                                Padding="0"
                                Background="Transparent"
                                Foreground="#3B2C1D"/>
                    </Grid>
                </Border>

                <TextBlock Grid.Column="2"
                           Text="{Binding LineTotal, StringFormat={}{0:0} грн}"
                           FontWeight="Bold"
                           Foreground="#17120E"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="54"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="370"/>
        </Grid.ColumnDefinitions>

        <Border Grid.RowSpan="3" Grid.Column="0" Background="#332719">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="210"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="142"/>
                </Grid.RowDefinitions>

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="8">
                    <Image Source="pack://application:,,,/Assets/Brand/Logo.png"
                           Width="173"
                           Height="132"
                           Stretch="Uniform"/>
                    <TextBlock Text="COFFEE"
                               FontSize="24"
                               Foreground="#E0AE65"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="SHOP"
                               FontSize="24"
                               Foreground="#E0AE65"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="10,24,10,12">
                    <Button Style="{StaticResource NavButtonStyle}" Content="Замовлення" Click="NavButton_Click" Background="#B99B77"/>
                    <Button Style="{StaticResource NavButtonStyle}" Content="Меню" Click="MenuButton_Click"/>
                    <Button Style="{StaticResource NavButtonStyle}" Content="Категорії" Click="CategoriesButton_Click"/>
                    <Button Style="{StaticResource NavButtonStyle}" Content="Історія замовлень" Click="OrdersHistoryButton_Click"/>
                    <Button Style="{StaticResource NavButtonStyle}" Content="Звіти" Click="ReportsButton_Click"/>
                    <Button Style="{StaticResource NavButtonStyle}" Content="Налаштування" Click="SettingsButton_Click"/>
                </StackPanel>

                <Border Grid.Row="2"
                        Margin="12,0,12,18"
                        BorderBrush="#5B4A36"
                        BorderThickness="1"
                        CornerRadius="8"
                        Background="#3C2D1E">
                    <Grid Margin="18,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="1"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="Сьогодні" Foreground="#D8C7B3"/>
                            <TextBlock x:Name="TodayTextBlock" Foreground="White" Margin="0,6,0,0"/>
                        </StackPanel>
                        <Rectangle Grid.Row="1" Fill="#5B4A36" Margin="0,6"/>
                        <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
                            <TextBlock Text="Час" Foreground="#D8C7B3"/>
                            <TextBlock x:Name="TimeTextBlock" Foreground="White" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Column="1" Grid.ColumnSpan="2"
                Background="#FCFAF7"
                BorderBrush="#E3DCD3"
                BorderThickness="0,0,0,1">
            <Grid Margin="24,0" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="☰" FontSize="18" Foreground="#3B2C1D" VerticalAlignment="Center"/>
                <TextBlock x:Name="HeaderUserTextBlock"
                           Grid.Column="2"
                           Text="Адміністратор"
                           Foreground="#4C4034"
                           VerticalAlignment="Center"
                           Margin="0,0,24,0"/>
            </Grid>
        </Border>

        <Grid x:Name="OrdersPageGrid" Grid.Row="1" Grid.Column="1" Margin="28,28,20,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="310"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Меню" FontSize="32" FontWeight="Bold" Foreground="#14100D"/>
                    <TextBlock Text="Оберіть товари для замовлення" Foreground="#5F5850" Margin="0,4,0,0"/>
                </StackPanel>

                <Grid Grid.Column="1" Margin="0,4,14,0">
                    <TextBox x:Name="SearchTextBox"
                             Height="42"
                             VerticalContentAlignment="Center"
                             TextChanged="SearchTextBox_TextChanged"/>
                    <TextBlock x:Name="SearchPlaceholderTextBlock"
                               Text="Пошук товарів..."
                               Foreground="#9A8F84"
                               Margin="16,0,0,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"/>
                </Grid>
                <Button Grid.Column="2" Content="Фільтр" Height="42" Margin="0,4,0,0"/>
            </Grid>

            <ScrollViewer Grid.Row="1"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Disabled"
                          Margin="0,26,0,24">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource CategoryButtonStyle}" Content="Усі" Tag="0" Background="#3B2C1D" Foreground="White" Click="CategoryButton_Click"/>
                    <Button Style="{StaticResource CategoryButtonStyle}" Content="Кава" Tag="1" Click="CategoryButton_Click"/>
                    <Button Style="{StaticResource CategoryButtonStyle}" Tag="2" Click="CategoryButton_Click">
                        <StackPanel>
                            <TextBlock Text="Гарячі" HorizontalAlignment="Center"/>
                            <TextBlock Text="напої" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource CategoryButtonStyle}" Tag="7" Click="CategoryButton_Click">
                        <StackPanel>
                            <TextBlock Text="Холодні" HorizontalAlignment="Center"/>
                            <TextBlock Text="напої" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource CategoryButtonStyle}" Content="Перекуси" Tag="4" Click="CategoryButton_Click"/>
                    <Button Style="{StaticResource CategoryButtonStyle}" Content="Випічка" Tag="5" Click="CategoryButton_Click"/>
                    <Button Style="{StaticResource CategoryButtonStyle}" Content="Десерти" Tag="6" Click="CategoryButton_Click"/>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ProductsItemsControl" ItemTemplate="{StaticResource ProductCardTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <Border x:Name="CartPanel"
                Grid.Row="1"
                Grid.Column="2"
                Margin="0,82,18,34"
                Background="White"
                BorderBrush="#E7DED2"
                BorderThickness="1"
                CornerRadius="10"
                Effect="{StaticResource SoftShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="78"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="112"/>
                    <RowDefinition Height="170"/>
                </Grid.RowDefinitions>

                <DockPanel Margin="20,0">
                    <TextBlock Text="Поточне замовлення"
                               FontSize="18"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Foreground="#17120E"/>
                </DockPanel>

                <ListBox x:Name="CartListBox"
                         Grid.Row="1"
                         BorderThickness="0"
                         Padding="16,4"
                         ItemTemplate="{StaticResource CartItemTemplate}"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <Border Grid.Row="2" BorderBrush="#E7DED2" BorderThickness="0,1,0,1">
                    <Grid Margin="20,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Разом:" FontSize="18" FontWeight="Bold" Foreground="#17120E"/>
                            <TextBlock x:Name="ItemsCountTextBlock" Text="Кількість позицій: 0" Foreground="#6E6256" Margin="0,8,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="TotalTextBlock"
                                   Grid.Column="1"
                                   Text="0 грн"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="#17120E"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="3" Margin="20,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="54"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="54"/>
                    </Grid.RowDefinitions>
                    <Button Content="Оформити замовлення"
                            Height="54"
                            FontSize="15"
                            HorizontalAlignment="Stretch"
                            Click="SaveOrderButton_Click"/>
                    <Button Grid.Row="2"
                            Content="Очистити замовлення"
                            Height="54"
                            Style="{StaticResource GhostButtonStyle}"
                            HorizontalAlignment="Stretch"
                            Click="ClearCartButton_Click"/>
                </Grid>
            </Grid>
        </Border>

        <ContentControl x:Name="PageContentControl"
                        Grid.Row="1"
                        Grid.Column="1"
                        Grid.ColumnSpan="2"
                        Margin="52,40,58,38"
                        Visibility="Collapsed"/>

        <Border Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Background="#FCFAF7" BorderBrush="#E3DCD3" BorderThickness="0,1,0,0">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="CoffeeShop System v1.0.0" Foreground="#6E6256" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="●  Підключено до бази даних" Foreground="#4FA35D" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock x:Name="FooterUserTextBlock" Grid.Column="2" Text="Користувач: Адміністратор" Foreground="#6E6256" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
