<Window x:Class="CoffeeShopApp.CategoriesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Категорії"
        Height="560"
        Width="820"
        WindowStartupLocation="CenterOwner"
        Background="#F8F6F2">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="Категорії меню"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="#17120E"/>
            <TextBlock Text="Групи товарів та кількість позицій"
                       Foreground="#6E6256"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#E7DED2"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Effect="{StaticResource SoftShadow}">
            <DataGrid x:Name="CategoriesDataGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="80"/>
                    <DataGridTextColumn Header="Назва категорії" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Товарів" Binding="{Binding ProductsCount}" Width="130"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Button Grid.Row="2"
                Content="Закрити"
                Width="120"
                HorizontalAlignment="Right"
                Margin="0,18,0,0"
                Style="{StaticResource GhostButtonStyle}"
                Click="CloseButton_Click"/>
    </Grid>
</Window>
