<Window x:Class="CoffeeShopApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CoffeeShop"
        Height="850"
        Width="1450"
        MinHeight="720"
        MinWidth="1150"
        WindowStartupLocation="CenterScreen"
        Background="#F8F6F2">

    <Window.Resources>
        <Style x:Key="CategoryButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
            <Setter Property="Height" Value="42"/>
            <Setter Property="MinWidth" Value="105"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>

        <DataTemplate x:Key="ProductCardTemplate">
            <Button Click="AddProductButton_Click"
                    Tag="{Binding Product}"
                    Background="Transparent"
                    Padding="0"
                    Margin="0,0,18,18">
                <Border Width="190"
                        Height="245"
                        Background="White"
                        BorderBrush="#E7DED2"
                        BorderThickness="1"
                        CornerRadius="8"
                        Effect="{StaticResource SoftShadow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="112"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Background="{Binding PhotoBrush}" CornerRadius="8,8,0,0"/>

                        <Grid Grid.Row="1" Margin="16,12,14,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="{Binding Product.Name}"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="#17120E"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Row="1"
                                       Text="{Binding Product.Description}"
                                       FontSize="12"
                                       Foreground="#5F5850"
                                       TextWrapping="Wrap"
                                       MaxHeight="38"
                                       Margin="0,8,0,0"/>
                            <DockPanel Grid.Row="3" LastChildFill="False">
                                <TextBlock Text="{Binding Product.Price, StringFormat={}{0:0} грн}"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           Foreground="#17120E"
                                           VerticalAlignment="Center"/>
                                <Border DockPanel.Dock="Right"
                                        Width="32"
                                        Height="32"
                                        Background="#3B2C1D"
                                        CornerRadius="8">
                                    <TextBlock Text="+"
                                               Foreground="White"
                                               FontSize="22"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Margin="0,-3,0,0"/>
                                </Border>
                            </DockPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="CartItemTemplate">
            <Grid Margin="0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="68"/>
                </Grid.ColumnDefinitions>

                <Border Width="50"
                        Height="50"
                        Background="{Binding PhotoBrush}"
                        CornerRadius="7"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Product.Name}"
                               FontWeight="SemiBold"
                               Foreground="#17120E"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Product.Price, StringFormat={}{0:0} грн}"
                               Foreground="#6E6256"
                               FontSize="12"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <Border Grid.Column="2"
                        Height="34"
                        BorderBrush="#E7DED2"
                        BorderThickness="1"
                        CornerRadius="7"
                        VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="-"
                                Tag="{Binding Product.Id}"
                                Click="DecreaseCartButton_Click"
                                Padding="0"
                                Background="Transparent"
                                Foreground="#3B2C1D"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Quantity}"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="2"
                                Content="+"
                                Tag="{Binding Product.Id}"
                                Click="IncreaseCartButton_Click"
                                Padding="0"
                                Background="Transparent"
                                Foreground="#3B2C1D"/>
                    </Grid>
                </Border>

                <TextBlock Grid.Column="3"
                           Text="{Binding LineTotal, StringFormat={}{0:0} грн}"
                           FontWeight="Bold"
                           Foreground="#17120E"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="370"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#332719">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="210"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="145"/>
                </Grid.RowDefinitions>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="COFFEE"
                               FontSize="26"
                               Foreground="White"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="SHOP"
                               FontSize="26"
                               Foreground="White"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="PREMIUM QUALITY"
                               FontSize="10"
                               Foreground="#EFE4D6"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="12,16">
                    <Button Style="{StaticResource NavButtonStyle}" Background="#B99B77" Content="Замовлення"/>
                    <Button Style="{StaticResource NavButtonStyle}" Content="Меню"/>
                    <Button Style="{StaticResource NavButtonStyle}" Content="Категорії" Click="CategoriesButton_Click"/>
                    <Button Style="{StaticResource NavButtonStyle}" Content="Історія" Click="OrdersHistoryButton_Click"/>
                    <Button Style="{StaticResource NavButtonStyle}" Content="Товари" Click="ProductsButton_Click"/>
                    <Button Style="{StaticResource NavButtonStyle}" Content="Звіти" Click="ReportsButton_Click"/>
                    <Button Style="{StaticResource NavButtonStyle}" Content="Налаштування" Click="SettingsButton_Click"/>
                </StackPanel>

                <Border Grid.Row="2"
                        Margin="14,0,14,22"
                        BorderBrush="#5B4A36"
                        BorderThickness="1"
                        CornerRadius="8"
                        Background="#3C2D1E">
                    <StackPanel Margin="18,14">
                        <TextBlock Text="Сьогодні" Foreground="#D8C7B3"/>
                        <TextBlock Text="15 травня 2025" Foreground="White" Margin="0,6,0,16"/>
                        <TextBlock Text="Час" Foreground="#D8C7B3"/>
                        <TextBlock Text="15:42" Foreground="White" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="28,28,20,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="310"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Меню"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="#14100D"/>
                    <TextBlock Text="Оберіть товари для замовлення"
                               Foreground="#5F5850"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <TextBox Grid.Column="1"
                         Height="42"
                         Margin="0,4,14,0"
                         VerticalContentAlignment="Center"
                         TextChanged="SearchTextBox_TextChanged"/>
                <Button Grid.Column="2"
                        Content="Фільтр"
                        Height="42"
                        Margin="0,4,0,0"/>
            </Grid>

            <ScrollViewer Grid.Row="1"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Disabled"
                          Margin="0,26,0,24">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource CategoryButtonStyle}" Content="Усі" Tag="0" Background="#3B2C1D" Foreground="White" Click="CategoryButton_Click"/>
                    <Button Style="{StaticResource CategoryButtonStyle}" Content="Кава" Tag="1" Click="CategoryButton_Click"/>
                    <Button Style="{StaticResource CategoryButtonStyle}" Content="Напої" Tag="2" Click="CategoryButton_Click"/>
                    <Button Style="{StaticResource CategoryButtonStyle}" Content="Сніданки" Tag="3" Click="CategoryButton_Click"/>
                    <Button Style="{StaticResource CategoryButtonStyle}" Content="Перекуси" Tag="4" Click="CategoryButton_Click"/>
                    <Button Style="{StaticResource CategoryButtonStyle}" Content="Випічка" Tag="5" Click="CategoryButton_Click"/>
                    <Button Style="{StaticResource CategoryButtonStyle}" Content="Десерти" Tag="6" Click="CategoryButton_Click"/>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ProductsItemsControl"
                              ItemTemplate="{StaticResource ProductCardTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <Border Grid.Column="2"
                Margin="0,100,18,34"
                Background="White"
                BorderBrush="#E7DED2"
                BorderThickness="1"
                CornerRadius="10"
                Effect="{StaticResource SoftShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="78"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="112"/>
                    <RowDefinition Height="150"/>
                </Grid.RowDefinitions>

                <DockPanel Margin="20,0">
                    <TextBlock Text="Поточне замовлення"
                               FontSize="18"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Foreground="#17120E"/>
                    <Button DockPanel.Dock="Right"
                            Content="X"
                            Width="36"
                            Height="36"
                            Padding="0"
                            Background="#F2EEE8"
                            Foreground="#9A642D"
                            Click="ClearCartButton_Click"/>
                </DockPanel>

                <ListBox x:Name="CartListBox"
                         Grid.Row="1"
                         BorderThickness="0"
                         Padding="16,4"
                         ItemTemplate="{StaticResource CartItemTemplate}"/>

                <Border Grid.Row="2" BorderBrush="#E7DED2" BorderThickness="0,1,0,1">
                    <Grid Margin="20,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Разом:"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#17120E"/>
                            <TextBlock x:Name="ItemsCountTextBlock"
                                       Text="Кількість позицій: 0"
                                       Foreground="#6E6256"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="TotalTextBlock"
                                   Grid.Column="1"
                                   Text="0 грн"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="#17120E"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="3" Margin="20,18">
                    <Button Content="Оформити замовлення"
                            Height="54"
                            FontSize="15"
                            Click="SaveOrderButton_Click"/>
                    <Button Content="Очистити замовлення"
                            Height="54"
                            Margin="0,16,0,0"
                            Style="{StaticResource GhostButtonStyle}"
                            Click="ClearCartButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
