<Window x:Class="CoffeeShopApp.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Налаштування"
        Height="520"
        Width="760"
        WindowStartupLocation="CenterOwner"
        Background="#F8F6F2">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="Налаштування"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="#17120E"/>
            <TextBlock Text="Основна інформація про систему"
                       Foreground="#6E6256"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#E7DED2"
                BorderThickness="1"
                CornerRadius="8"
                Padding="22"
                Effect="{StaticResource SoftShadow}">
            <StackPanel>
                <TextBlock Text="CoffeeShop System"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#17120E"/>
                <TextBlock Text="Версія: 1.0.0"
                           Foreground="#6E6256"
                           Margin="0,12,0,0"/>
                <TextBlock Text="Користувач: Адміністратор"
                           Foreground="#6E6256"
                           Margin="0,8,0,0"/>
                <TextBlock Text="База даних: CoffeeShopDb"
                           Foreground="#6E6256"
                           Margin="0,8,0,0"/>

                <Separator Margin="0,22"/>

                <CheckBox Content="Показувати підтвердження після збереження замовлення"
                          IsChecked="True"
                          FontSize="15"
                          Foreground="#3B2C1D"
                          Margin="0,0,0,12"/>
                <CheckBox Content="Використовувати світлу тему"
                          IsChecked="True"
                          FontSize="15"
                          Foreground="#3B2C1D"/>
            </StackPanel>
        </Border>

        <Button Grid.Row="2"
                Content="Закрити"
                Width="120"
                HorizontalAlignment="Right"
                Margin="0,18,0,0"
                Style="{StaticResource GhostButtonStyle}"
                Click="CloseButton_Click"/>
    </Grid>
</Window>
