<Window x:Class="CoffeeShopApp.ProductsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Товари"
        Height="640"
        Width="1040"
        WindowStartupLocation="CenterOwner"
        Background="#F8F6F2">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="Управління товарами"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="#17120E"/>
            <TextBlock Text="Перегляд асортименту кав'ярні"
                       Foreground="#6E6256"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#E7DED2"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Effect="{StaticResource SoftShadow}">
            <DataGrid x:Name="ProductsDataGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                    <DataGridTextColumn Header="Назва" Binding="{Binding Name}" Width="180"/>
                    <DataGridTextColumn Header="Категорія" Binding="{Binding Category}" Width="160"/>
                    <DataGridTextColumn Header="Опис" Binding="{Binding Description}" Width="*"/>
                    <DataGridTextColumn Header="Ціна" Binding="{Binding Price, StringFormat={}{0:0} ₴}" Width="100"/>
                    <DataGridCheckBoxColumn Header="В наявності" Binding="{Binding IsAvailable}" Width="110"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <Button Content="Оновити" Width="120" Click="RefreshButton_Click"/>
            <Button Content="Закрити" Width="120" Margin="12,0,0,0" Style="{StaticResource GhostButtonStyle}" Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
