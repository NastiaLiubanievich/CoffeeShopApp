<Window x:Class="CoffeeShopApp.ReportsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Звіти"
        Height="560"
        Width="920"
        WindowStartupLocation="CenterOwner"
        Background="#F8F6F2">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="Звіти та статистика"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="#17120E"/>
            <TextBlock Text="Короткий підсумок роботи кав'ярні"
                       Foreground="#6E6256"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,20">
            <Border Background="White" CornerRadius="8" Padding="18" Margin="0,0,12,0" Effect="{StaticResource SoftShadow}">
                <StackPanel>
                    <TextBlock Text="Замовлень" Foreground="#6E6256"/>
                    <TextBlock x:Name="OrdersCountTextBlock" FontSize="28" FontWeight="Bold" Foreground="#17120E" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="8" Padding="18" Margin="6,0" Effect="{StaticResource SoftShadow}">
                <StackPanel>
                    <TextBlock Text="Виручка" Foreground="#6E6256"/>
                    <TextBlock x:Name="RevenueTextBlock" FontSize="28" FontWeight="Bold" Foreground="#17120E" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="8" Padding="18" Margin="12,0,0,0" Effect="{StaticResource SoftShadow}">
                <StackPanel>
                    <TextBlock Text="Товарів у меню" Foreground="#6E6256"/>
                    <TextBlock x:Name="ProductsCountTextBlock" FontSize="28" FontWeight="Bold" Foreground="#17120E" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E7DED2"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Effect="{StaticResource SoftShadow}">
            <DataGrid x:Name="CategorySalesDataGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Категорія" Binding="{Binding Category}" Width="*"/>
                    <DataGridTextColumn Header="Продано одиниць" Binding="{Binding Quantity}" Width="160"/>
                    <DataGridTextColumn Header="Сума" Binding="{Binding Total, StringFormat={}{0:0} ₴}" Width="140"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Button Grid.Row="3"
                Content="Закрити"
                Width="120"
                HorizontalAlignment="Right"
                Margin="0,18,0,0"
                Style="{StaticResource GhostButtonStyle}"
                Click="CloseButton_Click"/>
    </Grid>
</Window>
